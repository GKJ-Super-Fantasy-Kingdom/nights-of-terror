<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.1.4</Version>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Super Fantasy Kingdom</GameDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(MSBuildProjectDirectory)\.analysis\profile</ProfileDir>
    <ManagedDir>$(GameDir)\Super Fantasy Kingdom_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="0Harmony;BepInEx">
      <HintPath>$(ProfileDir)\BepInEx\core\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp;UnityEngine;UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
